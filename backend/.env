# ─── JWT AUTHENTICATION ──────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── BCRYPT ──────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── REDIS (Caching — Dashboard & Analytics) ─────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TTL=300

# ─── AWS S3 (File Storage — KYC Docs, Service Images) ────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=urban-service-admin-uploads

# ─── PAYMENT GATEWAY ─────────────────────────────────────────
# Module 10 — Payment Management
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# STRIPE_SECRET_KEY=your_stripe_secret_key   # uncomment if using Stripe

# ─── EMAIL GATEWAY ───────────────────────────────────────────
# Module 12 — Notifications (Email dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Urban Service Admin <no-reply@urbanservice.com>"

# ─── SMS GATEWAY ─────────────────────────────────────────────
# Module 12 — Notifications (SMS dispatch)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ─── PUSH NOTIFICATIONS ──────────────────────────────────────
# Module 12 — Notifications (Push)
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
FCM_PROJECT_ID=your_firebase_project_id

# ─── GOOGLE MAPS (Location Module) ───────────────────────────
# Module 13 — Location Management (Zones, Geo-fencing)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── AUDIT LOG ───────────────────────────────────────────────
# Module 14 — Roles & Permissions (Audit log retention)
AUDIT_LOG_RETENTION_DAYS=90

# ─── APP VERSION ─────────────────────────────────────────────
# Module 15 — Settings (Force update)
APP_VERSION_ANDROID=1.0.0
APP_VERSION_IOS=1.0.0
FORCE_UPDATE=false

# ─── MISC ────────────────────────────────────────────────────
APP_NAME="Urban Service Admin"
FRONTEND_URL=http://localhost:3000